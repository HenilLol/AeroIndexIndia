NODE_ENV=production
PORT=10000

# Backend PostgreSQL Connection String (Supabase Direct or Pooler URL)
# Example: postgresql://postgres.user:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# CORS Allowed Origins (comma-separated origins for Vercel production frontend)
CORS_ORIGINS=
FRONTEND_URL=

# Authentication & Application Security
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Optional server-side provider credentials (never exposed to browser)
SKYSCANNER_API_KEY=
SKYSCANNER_LIVE_ENABLED=false
AVIATION_EDGE_API_KEY=
AVIATION_EDGE_LIVE_ENABLED=false
